---
import { Image } from "astro:assets";
import Icon from "./Icon.astro";
import { getImage } from "../lib/images";
---

<section id="about" aria-labelledby="about-heading">
  <div class="container">
    <div class="about-header fade-in">
      <div class="section-label">About Me</div>
      <h2 id="about-heading" class="section-title">
        Personal <em>Profile</em>
      </h2>
    </div>

    <div class="about-grid">
      <div class="about-image-wrapper fade-in">
        <div class="about-main-glass">
          <Image
            src={getImage("IMG_2598-Photoroom-1.png")}
            alt="Eve Sujittra Seelabat"
            class="about-profile-img"
          />
          <div class="about-inner-card">
            <div class="about-card-title">Portfolio</div>
            <div class="about-card-name">Sujittra Seelabat</div>
            <div class="about-card-role">Human Resources & Content Creator</div>
          </div>
        </div>
      </div>

      <div class="about-content fade-in">
        <p class="about-body">
          I am a fourth-year Bachelor of Information Science student at Khon
          Kaen University, and I am interested in Human Resources. I want to
          work as an HR Content Creator in Talent Acquisition. My background is
          in digital media, UX/UI, and graphic design, and I always focus on
          user-centered design.
        </p>
        <p class="about-body" style="margin-bottom: var(--space-8);">
          Before making any graphic or content, I always analyze the audience's
          experience, current trends, and what they need. I believe that in the
          HR world, candidates and employees are our most important "users." I
          want to use my design skills and audience insights to create digital
          content that strengthens employer branding. I am ready to support the
          team to make the hiring process more modern and easier for everyone.
        </p>

        <div class="about-values">
          <div class="value-item">
            <div class="value-icon"><Icon name="users" size={18} /></div>
            <div class="value-text">
              <h3>People First</h3>
              <p>Every initiative starts with humans at the center</p>
            </div>
          </div>
          <div class="value-item">
            <div class="value-icon"><Icon name="pen-tool" size={18} /></div>
            <div class="value-text">
              <h3>Creative Storytelling</h3>
              <p>Turning ideas into compelling content</p>
            </div>
          </div>
          <div class="value-item">
            <div class="value-icon"><Icon name="trending-up" size={18} /></div>
            <div class="value-text">
              <h3>Growth Mindset</h3>
              <p>Continuous learning drives everything I do</p>
            </div>
          </div>
          <div class="value-item">
            <div class="value-icon"><Icon name="heart" size={18} /></div>
            <div class="value-text">
              <h3>Authentic Culture</h3>
              <p>Building workplaces people genuinely love</p>
            </div>
          </div>
        </div>

        <a href="#contact" class="btn-primary" style="display:inline-flex;">
          <Icon name="message-circle" size={16} />
          Let's Connect
        </a>
      </div>
    </div>
  </div>
</section>

<section id="skills" aria-labelledby="skills-heading">
  <div class="container">
    <div
