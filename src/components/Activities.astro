</section>

<section id="experience" aria-labelledby="experience-heading">
  <div class="container">
    <div
      class="fade-in"
      style="margin-bottom: var(--space-10); max-width: var(--content-default);"
    >
      <div class="section-label">Education</div>
      <h2 id="experience-heading" class="section-title">
        Educational <em>Background</em>
      </h2>
    </div>

    <div class="education-layout">
      <article class="education-profile fade-in">
        <div>
          <div class="education-kicker">Undergraduate</div>
          <p class="education-period">2023 — Expected 2026</p>
          <h3 class="education-school">Khon Kaen University</h3>
          <p class="education-degree">
            Faculty of Humanities and Social Sciences · Bachelor of Information
            Science
          </p>
        </div>
        <p class="education-note">
          Open to internship opportunities where information, people, and
          creative digital communication meet.
        </p>
      </article>

      <div class="education-stats fade-in" style="transition-delay: 80ms;">
        <div class="education-stat">
          <span class="education-stat-label">Current Year</span>
          <strong class="education-stat-value">4th Year</strong>
        </div>
        <div class="education-stat">
          <span class="education-stat-label">Graduation</span>
          <strong class="education-stat-value">2026</strong>
        </div>
        <div class="education-stat">
          <span class="education-stat-label">Status</span>
          <strong class="education-stat-value">Open to Internship</strong>
        </div>
        <div class="education-stat">
          <span class="education-stat-label">GPAX</span>
          <strong class="education-stat-value">3.64</strong>
        </div>
      </div>
    </div>
  </div>
</section>

<section
