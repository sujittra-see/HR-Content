---
import Icon from "./Icon.astro";
---

<section id="contact" aria-labelledby="contact-heading" data-focus-gap="28">
  <div class="container">
    <div class="contact-grid">
      <div class="contact-slogan fade-in">
        <div class="contact-slogan-main">Every experience holds value.</div>
        <div class="contact-slogan-name">Sujittra Seelabat · Eve</div>
      </div>
      <div class="contact-info fade-in">
        <div class="section-label">Get In Touch</div>
        <h2 id="contact-heading" class="section-title">
          Let's Work <em>Together</em>
        </h2>
        <p class="contact-desc">
          Open to internship opportunities, creative content work, and
          collaborative projects where people, information, and design meet.
        </p>

        <div class="contact-items">
          <a class="contact-item" href="mailto:Sujittra.laa@gmail.com">
            <div class="contact-item-icon"><Icon name="mail" size={20} /></div>
            <div class="contact-item-text">
              <div class="contact-item-label">Email</div>
              <div class="contact-item-value">Sujittra.laa@gmail.com</div>
            </div>
          </a>
          <a class="contact-item" href="tel:+66931749166">
            <div class="contact-item-icon"><Icon name="phone" size={20} /></div>
            <div class="contact-item-text">
              <div class="contact-item-label">PHONE</div>
              <div class="contact-item-value">093-174-9166</div>
            </div>
          </a>
          <div class="contact-item">
            <div class="contact-item-icon">
              <Icon name="map-pin" size={20} />
            </div>
            <div class="contact-item-text">
              <div class="contact-item-label">Location</div>
              <div class="contact-item-value">Khon Kaen, Thailand</div>
            </div>
          </div>
          <div class="contact-item">
            <div class="contact-item-icon">
              <Icon name="briefcase" size={20} />
            </div>
            <div class="contact-item-text">
              <div class="contact-item-label">Availability</div>
              <div class="contact-item-value">Open for Internship</div>
            </div>
          </div>
        </div>

